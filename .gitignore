# 注意：这里用 build/ 而不是 /build/。单斜杠只匹配仓库根目录，
# 早期版本用 /build 导致 app/build 下几千个构建产物被误纳入版本控制。
build/
.gradle/
.kotlin/
local.properties
**/local.properties
.idea/
*.iml
*.apk
*.aab
*.keystore
*.hprof
.DS_Store
captures/
.externalNativeBuild/
.cxx/
# 测试夹具由 tools/make_*_fixture.py 生成，不入库（通配覆盖 _ep_long 等变体）
tools/testfixture*/
# net_diag 的输出是对本机网络的快照，不入库
vpn_off.txt
vpn_on.txt
# 目标站年龄门画面含成人内容标识，不入库
docs/screenshots/age-gate.png
docs/screenshots/flicker-dbg.png
docs/screenshots/ready.png
docs/screenshots/typed-url.png

# Python 字节码缓存不入库
__pycache__/
# video2code 插件的运行时状态（守门 hook 把本项目的 app/src 误认成复刻产物目录时生成）
.v2c/
out/
