<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      手写而非图像生成：应用图标是精确几何，扩散模型两次尝试都退化成线框。

      设计语言取自今年主流视频 App（YouTube / Netflix / bilibili / Venera）：
      纯色底 + 单一符号 + 粗笔画 + 无镂空。镂空与多元素在小尺寸下最先糊掉，
      一个实心播放三角是最经得起缩放的表意。

      圆角来自 strokeLineJoin=round 的描边叠加填充（三角形三个角都是
      join，闭合路径无 cap），避免手写圆角弧线数据。重心 (54,54) 恰在
      画布中心，含 4.5dp 描边扩张后全部落在 66dp 安全区内。
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40,33 L40,75 L82,54 Z"
        android:strokeColor="#FFFFFF"
        android:strokeLineJoin="round"
        android:strokeWidth="9" />
</vector>
