<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainActivity">

    <!-- 地址栏 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/urlInputLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:hint="@string/url_hint"
        app:layout_constraintEnd_toStartOf="@id/shieldButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/urlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 防护状态开关：常驻可见，让防护开没开一眼看得见 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/shieldButton"
        style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/action_shield"
        android:text="@string/action_shield"
        app:layout_constraintBottom_toBottomOf="@id/urlInputLayout"
        app:layout_constraintEnd_toStartOf="@id/loadButton"
        app:layout_constraintTop_toTopOf="@id/urlInputLayout" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/loadButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="@string/action_load"
        app:layout_constraintBottom_toBottomOf="@id/urlInputLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/urlInputLayout" />

    <TextView
        android:id="@+id/statusLine"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/on_surface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/urlInputLayout"
        tools:text="沙箱运行中 · 已拦截 3 个跟踪请求" />

    <!-- 播放器 -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        android:background="@android:color/black"
        app:layout_constraintBottom_toTopOf="@id/listHeader"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusLine"
        app:layout_constraintVertical_bias="0.0"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="true" />

    <TextView
        android:id="@+id/listHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        app:layout_constraintBottom_toTopOf="@id/playlistList"
        app:layout_constraintEnd_toStartOf="@id/speedButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playerView"
        tools:text="发现 3 个视频" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/speedButton"
        style="@style/Widget.Material3.Button.IconButton.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="1.0x"
        app:layout_constraintBottom_toBottomOf="@id/listHeader"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/listHeader" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/playlistList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/listHeader"
        tools:listitem="@layout/item_video" />

</androidx.constraintlayout.widget.ConstraintLayout>
