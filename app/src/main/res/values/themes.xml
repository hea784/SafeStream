<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SafeStream" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
    </style>

    <!-- 沙箱页面：无标题栏、纯背景、无 ActionBar，避免与主 UI 混淆 -->
    <style name="Theme.SafeStream.Sandbox" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
